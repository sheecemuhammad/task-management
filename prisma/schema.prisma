// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  password  String?
  name      String
  avatarUrl String?

  teamMembers     TeamMember[]
  tasksAssigned   Task[]           @relation("TaskAssignee")
  comments        Comment[]
  auditLogs       AuditLog[]
  refreshSessions RefreshSession[]
  oauthAccounts   OAuthAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OAuthAccount {
  id         String @id @default(uuid())
  provider   String
  providerId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerId])
  @@index([userId])
}

model Team {
  id          String           @id @default(uuid())
  name        String
  members     TeamMember[]
  taskGroups  TaskGroup[]
  invitations TeamInvitation[]

  createdAt DateTime @default(now())
}

model TeamMember {
  id   String @id @default(uuid())
  role Role   @default(MEMBER)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  permissions TeamMemberPermission[]

  @@unique([userId, teamId])
  @@index([teamId])
}

model TeamInvitation {
  id        String @id @default(uuid())
  email     String
  role      Role   @default(MEMBER)
  tokenHash String @unique
  teamId    String

  expiresAt  DateTime
  acceptedAt DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([email])
  @@index([teamId])
  @@index([expiresAt])
}

model Feature {
  id          String  @id @default(uuid())
  name        String
  key         String  @unique
  description String?

  permissions Permission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(uuid())
  name        String
  key         String  @unique
  description String?

  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureId String

  teamMembers TeamMemberPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([featureId])
}

model TeamMemberPermission {
  id String @id @default(uuid())

  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  teamMemberId String

  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String

  createdAt DateTime @default(now())

  @@unique([teamMemberId, permissionId])
  @@index([teamMemberId])
  @@index([permissionId])
}

model TaskGroup {
  id   String @id @default(uuid())
  name String

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  tasks Task[]

  shareToken String? @unique
  isPublic   Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([teamId])
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  priority    Int        @default(1)

  taskGroup TaskGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String

  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assigneeId String?

  attachments Attachment[]
  comments    Comment[]

  dueDate DateTime?

  shareToken String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([assigneeId])
  @@index([dueDate])
}

model Comment {
  id      String @id @default(uuid())
  content String @db.Text

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  parent   Comment? @relation("NestedComments", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?

  children Comment[] @relation("NestedComments")

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([authorId])
  @@index([parentId])
}

model Attachment {
  id       String @id @default(uuid())
  url      String
  publicId String
  mimeType String
  size     Int

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  createdAt DateTime @default(now())

  @@index([taskId])
}

model AuditLog {
  id         String @id @default(uuid())
  action     String
  entityType String
  entityId   String

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  details Json

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
}

model RefreshSession {
  id        String @id @default(uuid())
  tokenHash String @unique

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
