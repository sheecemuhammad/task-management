# Application
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_management?schema=public

# Auth / JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# SMTP (Mailcatcher defaults for local docker-compose)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Task Management <noreply@localhost>"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis Streams (optional overrides)
REALTIME_STREAM_NAME=task-management-events
REALTIME_CONSUMER_GROUP=task-management-group
REALTIME_RECLAIM_IDLE_MS=30000
COMMENT_LIKE_STREAM_NAME=comment-like-events
COMMENT_LIKE_CONSUMER_GROUP=comment-like-group
COMMENT_LIKE_RECLAIM_IDLE_MS=30000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
